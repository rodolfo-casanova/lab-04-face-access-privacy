RESULTS_DIR=/app/results
CACHE_DIR=/app/cache
TORCH_HOME=/app/cache/torch
HF_HOME=/app/cache/hf
YOLO_CONFIG_DIR=/app/cache/ultralytics
MPLCONFIGDIR=/tmp/mpl
# MLflow and MinIO are optional. Without these variables the code runs without them.
# MLFLOW_TRACKING_URI=http://mlflow:5000
# MINIO_ENDPOINT=http://minio:9000
BIO_IDENTITIES=30
BACKEND_URL=http://bio-backend:8002
DEVICE_URL=http://bio-device:8001
VERIFY_THRESHOLD=0.35
# DEMO keys. In production they come from an HSM or a secrets manager, never from the repository.
SENSOR_KEY=change-this-sensor-key
TEMPLATE_KEY=change-this-template-key
